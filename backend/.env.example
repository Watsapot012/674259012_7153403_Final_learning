# ===================================================
# Backend Environment Variables
# Learning Resources Management System (7153403)
# ===================================================

# พอร์ตสำหรับรัน Backend API (Render จะกำหนด PORT ให้อัตโนมัติในโหมด Production)
PORT=5000
NODE_ENV=development

# ---------------------------------------------------
# การตั้งค่าฐานข้อมูล PostgreSQL (เลือกใช้งานแบบใดแบบหนึ่ง)
# ---------------------------------------------------
# แบบที่ 1: Connection String (เหมาะสำหรับ Render PostgreSQL, Supabase, Neon)
DATABASE_URL=postgres://username:password@hostname:5432/learning_resources_db

# แบบที่ 2: แยกพารามิเตอร์แต่ละตัว (เหมาะสำหรับเครื่อง Local หรือ Server ทั่วไป)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learning_resources_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# ---------------------------------------------------
# CORS Configuration (Frontend URL ที่อนุญาตให้เรียก API)
# ---------------------------------------------------
# ในเครื่อง Local: http://localhost:5173
# บน Production: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
